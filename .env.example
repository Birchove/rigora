# 推荐直接跑 `uv run rigora-setup`：它会在浏览器里介绍产品、逐个 Agent 说明用途，
# 然后把下面这些值写好，避免手工对齐 AGENTS 分配。手工编辑时再参考本文件。
#
# Copy to .env. Do not put real secrets in this file or in git.
# Settings 会从仓库根目录 .env 读取（pytest 期间不读，避免测试吃到本地 key）。
#
# 正式运行不再有 demo 兜底：五个 Agent 必须全部分配到某个槽，否则启动直接报错。
# 只有显式写 RESEARCH_MENTOR_MODEL_PROVIDER=demo 才会使用 fixture 模型。
#
# 每家：API key、BASE_URL、模型名、API_STYLE、AGENTS（可多选）。
# Agent 可选项: idea_review | plan_loop | key_insight_check | working_qa | complete
# AGENTS 写法: idea_review,plan_loop  或  [key_insight_check, plan_loop]  或  all
# idea_review / working_qa / complete 仍只能出现在一个槽里，且必须被分配。
# plan_loop 与 key_insight_check 的并行路径由下面的 PLAN_CHECK_PAIRS 显式决定。
# API_STYLE 可选项: chat_completions | responses
# BASE_URL 填到 /v1（或商家兼容前缀）这一级，不要带 /chat/completions。
# 占位 xxxx 视为未填写。同一把 ChatGPT key 的第二个模型用下面 CHATGPT_2_*，
# key / BASE_URL / API_STYLE 留空则继承 ChatGPT 主槽（引导面板不再展示这个槽）。
#
# 模型名核对时间 2026-09-07。注意两处已下线的旧名：
#   deepseek-chat / deepseek-reasoner 自 2026-07-24 起停用，请用 deepseek-v4-*；
#   gpt-4o / gpt-4.1 / o4-mini 已退役，o3 于 2026-08 下线。

# --- 千问 Qwen ---
# 官方: https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型可选项: qwen3.8-max | qwen3.8-flash | qwen3.7-max | qwen3.7-plus | qwen3.7-flash | qwen3-max | qwen-long
RESEARCH_MENTOR_QWEN_API_KEY=xxxx
RESEARCH_MENTOR_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RESEARCH_MENTOR_QWEN_MODEL=qwen3.7-plus
RESEARCH_MENTOR_QWEN_API_STYLE=chat_completions
RESEARCH_MENTOR_QWEN_AGENTS=

# --- Deepseek ---
# 官方: https://api.deepseek.com
# 模型可选项: deepseek-v4-pro | deepseek-v4-flash | deepseek-v4-flash-vision-exp
RESEARCH_MENTOR_DEEPSEEK_API_KEY=xxxx
RESEARCH_MENTOR_DEEPSEEK_BASE_URL=https://api.deepseek.com
RESEARCH_MENTOR_DEEPSEEK_MODEL=deepseek-v4-flash
RESEARCH_MENTOR_DEEPSEEK_API_STYLE=chat_completions
RESEARCH_MENTOR_DEEPSEEK_AGENTS=

# --- ChatGPT ---
# 官方: https://api.openai.com/v1
# 模型可选项: gpt-6-astra | gpt-5.6-sol | gpt-5.6-terra | gpt-5.6-luna | gpt-5.6
RESEARCH_MENTOR_CHATGPT_API_KEY=xxxx
RESEARCH_MENTOR_CHATGPT_BASE_URL=https://api.openai.com/v1
RESEARCH_MENTOR_CHATGPT_MODEL=gpt-5.6-terra
RESEARCH_MENTOR_CHATGPT_API_STYLE=responses
RESEARCH_MENTOR_CHATGPT_AGENTS=

# --- ChatGPT 第二槽（同一把 key、另一个模型）---
# 只留给手工编辑。面板一家只展示一个槽，需要多条路径时在 PLAN_CHECK_PAIRS 里复用同一家。
RESEARCH_MENTOR_CHATGPT_2_API_KEY=
RESEARCH_MENTOR_CHATGPT_2_BASE_URL=
RESEARCH_MENTOR_CHATGPT_2_MODEL=
RESEARCH_MENTOR_CHATGPT_2_API_STYLE=
RESEARCH_MENTOR_CHATGPT_2_AGENTS=

# --- GLM ---
# 官方: https://open.bigmodel.cn/api/paas/v4
# 模型可选项: glm-5.3 | glm-5.3-flash | glm-5.2 | glm-5.1 | glm-5-turbo
RESEARCH_MENTOR_GLM_API_KEY=xxxx
RESEARCH_MENTOR_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RESEARCH_MENTOR_GLM_MODEL=glm-5.3-flash
RESEARCH_MENTOR_GLM_API_STYLE=chat_completions
RESEARCH_MENTOR_GLM_AGENTS=

# --- 方案生成 × 点睛之笔评分的并行配对 ---
# 格式「提案槽>评审槽」，逗号分隔，有序，最多 3 对。左边的槽必须挂 plan_loop，
# 右边的槽必须挂 key_insight_check，否则启动报错。
#   1 对 → 只有 low（单方案）可用；mid / high 会被拒绝，而不是退化成同模型自审。
#   2 对 → 前两条路按顺序配对，high 的第三条路用 PLAN_CHECK_HIGH_CROSS 的交错组合补齐。
#   3 对 → 三种模式都可用，每条路就是你写的一对。
# 例: qwen>glm,deepseek>chatgpt
# 留空则退回旧行为：按 ChatGPT → ChatGPT 第二槽 → 千问 → GLM → Deepseek 的顺序，
# 取同时挂了 plan_loop 与 key_insight_check 的槽轮转配对。
RESEARCH_MENTOR_PLAN_CHECK_PAIRS=
# 恰好 2 对时 high 的第三条路取哪个交错组合：
#   ad = 第一家提 · 第二家审，bc = 第二家提 · 第一家审
RESEARCH_MENTOR_PLAN_CHECK_HIGH_CROSS=ad

# --- OpenAlex ---
# 免费账户 API key 提高日额度。不填走匿名池，额度很低，演示时容易被限流。
# 申请: https://openalex.org/settings/api  占位 xxxx 视为未填写。
RESEARCH_MENTOR_OPENALEX_API_KEY=xxxx
# 已废弃：服务端忽略此项，保留仅为兼容旧 .env。
RESEARCH_MENTOR_OPENALEX_MAILTO=

# true 时空库会 seed 三个 demo 项目（标记 DEMO DATA）；不影响真实模型调用。
RESEARCH_MENTOR_DEMO_MODE=false
RESEARCH_MENTOR_DATABASE_URL=sqlite+aiosqlite:///./research_mentor.db
RESEARCH_MENTOR_UPLOAD_ROOT=./data/uploads
RESEARCH_MENTOR_PUBLIC_BASE_URL=http://localhost:8000

# --- 项目文档 RAG rerank（FlagEmbedding / BGE）---
# 工具包: https://github.com/FlagOpen/FlagEmbedding
# 模型页: https://huggingface.co/BAAI/bge-reranker-v2-m3
# 权重约 1GB，写入 ./data/models（已 gitignore，不进仓库）。
# 国内下载走 ModelScope，不要用 hf-mirror.com + huggingface_hub 1.29（跨域 308 会失败）。
#   uv sync --extra local-ranking
#   uv run --extra local-ranking python -m research_mentor.cli.download_reranker --mirror
#   uv run --extra local-ranking python -m research_mentor.cli.download_reranker --login --official
# endpoint: mirror / modelscope = ModelScope；hf-mirror；official
# token: 仅官网需要。Hugging Face Access Token，或环境变量 HF_TOKEN
# backend: auto（已装则用 FlagEmbedding；pytest 自动跳过权重）
#          flagembedding | lexical | unavailable
RESEARCH_MENTOR_RERANKER_BACKEND=auto
RESEARCH_MENTOR_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RESEARCH_MENTOR_RERANKER_CACHE_DIR=./data/models
RESEARCH_MENTOR_HF_ENDPOINT=mirror
RESEARCH_MENTOR_HF_TOKEN=xxxx
