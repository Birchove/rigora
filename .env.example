# --- 方案生成 × 点睛之笔评分的并行配对 ---
# 格式「提案槽>评审槽」，逗号分隔，有序，最多 3 对。左边的槽必须挂 plan_loop，
# 右边的槽必须挂 key_insight_check，否则启动报错。
#   1 对 → 只有 low（单方案）可用；mid / high 会被拒绝，而不是退化成同模型自审。
#   2 对 → 默认双方案。只有把 PLAN_CHECK_HIGH_CROSS 设成 ad 或 bc 才会补第三条路。
#   3 对 → 三种模式都可用，每条路就是你写的一对。
# 例: qwen>glm,deepseek>chatgpt
# 留空则退回旧行为：按 ChatGPT → ChatGPT 第二槽 → 千问 → GLM → Deepseek 等顺序，
# 取同时挂了 plan_loop 与 key_insight_check 的槽轮转配对。
RESEARCH_MENTOR_PLAN_CHECK_PAIRS=
# 恰好 2 对时 high 的第三条路：off = 不补（默认双方案）；
#   ad = 第一家提 · 第二家审，bc = 第二家提 · 第一家审
RESEARCH_MENTOR_PLAN_CHECK_HIGH_CROSS=off

# --- OpenAlex ---
# 免费账户 API key 提高日额度。不填走匿名池，额度很低，演示时容易被限流。
# 申请: https://openalex.org/settings/api  占位 xxxx 视为未填写。
RESEARCH_MENTOR_OPENALEX_API_KEY=xxxx
# 已废弃：服务端忽略此项，保留仅为兼容旧 .env。
RESEARCH_MENTOR_OPENALEX_MAILTO=

# true 时空库会 seed 三个 demo 项目（标记 DEMO DATA）；不影响真实模型调用。
RESEARCH_MENTOR_DEMO_MODE=false
RESEARCH_MENTOR_DATABASE_URL=sqlite+aiosqlite:///./research_mentor.db
RESEARCH_MENTOR_UPLOAD_ROOT=./data/uploads
RESEARCH_MENTOR_PUBLIC_BASE_URL=http://localhost:8000

# --- 项目文档 RAG rerank（FlagEmbedding / BGE）---
# 工具包: https://github.com/FlagOpen/FlagEmbedding
# 模型页: https://huggingface.co/BAAI/bge-reranker-v2-m3
# 权重约 1GB，写入 ./data/models（已 gitignore，不进仓库）。
# 国内下载走 ModelScope，不要用 hf-mirror.com + huggingface_hub 1.29（跨域 308 会失败）。
#   uv sync --extra local-ranking
#   uv run --extra local-ranking python -m research_mentor.cli.download_reranker --mirror
#   uv run --extra local-ranking python -m research_mentor.cli.download_reranker --login --official
# endpoint: mirror / modelscope = ModelScope；hf-mirror；official
# token: 仅官网需要。Hugging Face Access Token，或环境变量 HF_TOKEN
# backend: auto（已装则用 FlagEmbedding；pytest 自动跳过权重）
#          flagembedding | lexical | unavailable
RESEARCH_MENTOR_RERANKER_BACKEND=auto
RESEARCH_MENTOR_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RESEARCH_MENTOR_RERANKER_CACHE_DIR=./data/models
RESEARCH_MENTOR_HF_ENDPOINT=mirror
RESEARCH_MENTOR_HF_TOKEN=xxxx
