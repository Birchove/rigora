# Copy to .env. Do not put real secrets in this file or in git.

RESEARCH_MENTOR_MODEL_PROVIDER=demo
RESEARCH_MENTOR_MODEL_NAME=gpt-5-mini
RESEARCH_MENTOR_MODEL_API_KEY=
# RESEARCH_MENTOR_MODEL_BASE_URL=https://api.example.com/v1

RESEARCH_MENTOR_DEMO_MODE=true
RESEARCH_MENTOR_DATABASE_URL=sqlite+aiosqlite:///./research_mentor.db
RESEARCH_MENTOR_UPLOAD_ROOT=./data/uploads
RESEARCH_MENTOR_PUBLIC_BASE_URL=http://localhost:8000

RESEARCH_MENTOR_MAX_CHECK_ROUNDS=5
RESEARCH_MENTOR_CHECK_PASS_SCORE=6.0
RESEARCH_MENTOR_RAG_RELEVANCE_THRESHOLD=0.3

# OpenAlex polite-pool contact is passed as OpenAlexRetriever(mailto=...), not a Settings field.
# See README for Anydoc (default extra) and FlagEmbedding (`uv sync --extra local-ranking`).
